# encryption_key
ENCRYPTION_ALGORITHM = aes-gcm
ENCRYPTION_KEY = your_key

# database variables
MYSQL_HOST = your_value
MYSQL_PORT = your_value
MYSQL_DATABASE = your_value
MYSQL_USER = your_value
MYSQL_PASSWORD = your_value

# email variables
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_SECURITY = starttls
SMTP_USER = your_gmail_address
EMAIL_SENDER = your_gmail_address
EMAIL_RECIPIENT = your_value

# SMTP login: oauth2 (Gmail without an app password) or password
SMTP_AUTH = oauth2
# only for SMTP_AUTH = password, encrypted with script/encrypt_value.py
# SMTP_PASSWORD = your_value

# oauth2 variables, see the steps in script/create_oauth_token.py
OAUTH_CLIENT_ID = your_value
OAUTH_CLIENT_SECRET = your_encrypted_value
OAUTH_REFRESH_TOKEN = your_encrypted_value
